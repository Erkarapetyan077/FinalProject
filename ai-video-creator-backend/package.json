{
  "name": "ai-video-creator-backend",
  "version": "1.0.0",
  "description": "Express + PostgreSQL + Sequelize backend for an AI video creation platform, with JWT auth, Swagger docs, Pexels stock video search, ElevenLabs voiceover generation and FFmpeg exports.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check.js"
  },
  "keywords": [
    "express",
    "sequelize",
    "postgresql",
    "jwt",
    "swagger",
    "ffmpeg",
    "video"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35"
  }
}

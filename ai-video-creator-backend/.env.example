# ============================================================
# AI Video Creator Backend - environment configuration
# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
# NEVER commit the real .env file (it is git-ignored).
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=5000

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_video_creator
DB_USER=postgres
DB_PASSWORD=postgres
# Optional: a full connection string overrides the DB_* variables above.
# Must start with postgres:// or postgresql:// - other protocols are ignored.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_video_creator

# ---- Authentication ----
# Use a long random string in any real environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- CORS / Frontend ----
# Comma-separated list of allowed origins for the React app.
# Example: CLIENT_URL=http://localhost:3000,https://myapp.com
CLIENT_URL=http://localhost:5173

# ---- Pexels stock video search (https://www.pexels.com/api/) ----
# The key is used ONLY on the backend and is never exposed to the frontend.
# Leave empty to receive clearly-flagged development mock data
# from GET /api/videos/search.
PEXELS_API_KEY=

# ---- ElevenLabs voiceover generation (https://elevenlabs.io/) ----
# Leave empty to disable audio generation - the generate endpoint then
# responds with 503 and clear guidance instead of failing unexpectedly.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Uploads / exports ----
# Directory (relative to the project root) for generated audio and videos.
UPLOAD_DIR=uploads
